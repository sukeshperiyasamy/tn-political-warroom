# ==============================================================================
# TN Political War Room — Environment Configuration Template (.env.example)
# Copy this file to .env and configure values for your environment.
# Note: All third-party social connectors are optional. When omitted, connectors
# are safely marked NOT_CONFIGURED or AUTH_REQUIRED and will not cause errors.
# ==============================================================================

# Core API & Server Configuration
PORT=8000
NEXT_PUBLIC_API_URL=http://localhost:8000
NODE_ENV=development

# Optional Context7 Documentation Key
CONTEXT7_API_KEY=

# ------------------------------------------------------------------------------
# Multi-Source Social Connectors (Optional)
# ------------------------------------------------------------------------------

# YouTube Data API v3 Key
# Required for live video discovery across verified Tamil political channels
YOUTUBE_API_KEY=

# X (Twitter) API v2 Bearer Token
# Required for live hashtag search and tweet engagement monitoring
X_BEARER_TOKEN=

# Reddit OAuth Application Credentials
# Required for querying r/TamilNadu and regional political discussions
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=TNWarroomIntelligence/1.0 (by /u/tn_warroom)

# Meta Graph API (Instagram & Facebook Pages)
# Required for indexed political reels and verified party page posts
INSTAGRAM_ACCESS_TOKEN=
FACEBOOK_PAGE_ACCESS_TOKEN=

# ------------------------------------------------------------------------------
# SQLite Database Configuration
# ------------------------------------------------------------------------------
# Concurrency Mode: WAL (Write-Ahead Logging) enabled with 5000ms busy timeout
# Path: backend/app/data/warroom.db
